#!/sbin/openrc-run

command="/usr/local/space-ui/space-ui"
command_background=true
pidfile="/run/space-ui.pid"
description="space-ui Service"
procname="space-ui"
depend() {
    need net
}
start_pre(){
    cd /usr/local/space-ui
}
reload() {
  ebegin "Reloading ${RC_SVCNAME}"
  kill -USR1  $pidfile
  eend $?
}