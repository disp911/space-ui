# Ignore editor and IDE settings
.idea/
.vscode/
.cache/
.sync*

# Ignore log files
*.log

# Ignore temporary files
tmp/
*.tar.gz

# Ignore build and distribution directories
backup/
bin/
dist/
release/
node_modules/

# Ignore compiled binaries
main

# Ignore script and executable files
/release.sh
/space-ui

# Ignore OS specific files
.DS_Store
Thumbs.db

# Ignore Go build files
*.exe
space-ui.db

# Ignore Docker specific files
docker-compose.override.yml

# Ignore .env (Environment Variables) file
.env

# v3 frontend build output, embedded by web/web.go
/web/app/*
!/web/app/.gitkeep

# Design mockups and the kit preview, kept outside the repository
/web/new-design/
/kit.html
