# Ignore editor and IDE settings
.idea/
# The shared launch and task settings are kept, the rest of .vscode is not
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.cache/
.sync*

# Ignore log files
*.log

# Ignore temporary files
tmp/
*.tar.gz

# Ignore build and distribution directories
bin/
dist/
node_modules/

# Ignore compiled binaries
main

# Ignore the built binary
/space-ui

# Ignore OS specific files
.DS_Store
Thumbs.db

# Ignore Go build files
*.exe
space-ui.db

# Ignore Docker specific files
docker-compose.override.yml

# Ignore .env (Environment Variables) file
.env

# v3 frontend build output, embedded by web/web.go
/web/app/*
!/web/app/.gitkeep

# Design mockups, kept outside the repository
/web/new-design/
