[Unit]
Description=space-ui Service
After=network.target
Wants=network.target

[Service]
EnvironmentFile=-/etc/conf.d/space-ui
Environment="XRAY_VMESS_AEAD_FORCED=false"
Type=simple
WorkingDirectory=/usr/lib/space-ui/
ExecStart=/usr/lib/space-ui/space-ui
ExecReload=kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
